import CompactStandardLibrary;

// Loan status representation for the MVP lifecycle
export enum LoanStatus {
  requested,
  funded,
  repaid,
  settled
}

/**
 * Public Loan Details Structure
 *
 * PRIVACY BOUNDARY DESIGN:
 * This struct represents the public, discoverable agreement terms that lenders legitimately
 * need to evaluate and fulfill a loan request.
 *
 * Sensitive borrower financial values (e.g. actual income, exact wallet balance, banking
 * credentials) remain strictly off-chain within the borrower's private witness context.
 * Only the verified eligibility result (isEligibilityVerified) is published on-chain.
 */
export struct LoanDetails {
  borrower: Bytes<32>,
  lender: Maybe<Bytes<32>>,
  amount: Uint<64>,
  interestRateBasisPoints: Uint<16>,
  durationBlocks: Uint<32>,
  status: LoanStatus,
  isEligibilityVerified: Boolean,
}

// -----------------------------------------------------------------------------
// On-chain Public Ledger State
// -----------------------------------------------------------------------------

// Discoverable loan participants
export ledger borrower: Bytes<32>;
export ledger lender: Maybe<Bytes<32>>;

// Public loan terms required for marketplace discovery
export ledger amount: Uint<64>;
export ledger interestRateBasisPoints: Uint<16>;
export ledger durationBlocks: Uint<32>;

// Public loan lifecycle status
export ledger status: LoanStatus;

// Public verification flag: confirms ZK eligibility proof verification
// without revealing the underlying private financial witnesses on-chain.
export ledger isEligibilityVerified: Boolean;

// -----------------------------------------------------------------------------
// Contract Initialization
// -----------------------------------------------------------------------------

/**
 * Initializes the loan desk contract instance with the requested terms.
 * All public parameters are explicitly disclosed to the ledger state.
 * Eligibility starts unverified (false) and will be updated by future ZK proof circuits.
 */
constructor(
  borrowerPk: Bytes<32>,
  principalAmount: Uint<64>,
  interestRate: Uint<16>,
  termBlocks: Uint<32>
) {
  assert(principalAmount > 0, "Loan amount must be greater than zero");
  assert(termBlocks > 0, "Loan duration must be greater than zero");

  borrower = disclose(borrowerPk);
  lender = none<Bytes<32>>();
  amount = disclose(principalAmount);
  interestRateBasisPoints = disclose(interestRate);
  durationBlocks = disclose(termBlocks);
  status = LoanStatus.requested;
  isEligibilityVerified = false;
}

// -----------------------------------------------------------------------------
// Inspection Circuits
// -----------------------------------------------------------------------------

// Circuit to inspect current loan status
export circuit getLoanStatus(): LoanStatus {
  return status;
}

// Circuit to inspect full public loan details
export circuit getLoanDetails(): LoanDetails {
  return LoanDetails {
    borrower: borrower,
    lender: lender,
    amount: amount,
    interestRateBasisPoints: interestRateBasisPoints,
    durationBlocks: durationBlocks,
    status: status,
    isEligibilityVerified: isEligibilityVerified,
  };
}
