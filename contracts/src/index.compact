import CompactStandardLibrary;

// Loan status representation for the MVP lifecycle
export enum LoanStatus {
  requested,
  funded,
  repaid,
  settled
}

/**
 * Public Loan Details Structure
 *
 * PRIVACY BOUNDARY & ELIGIBILITY DESIGN:
 * This struct represents the public, discoverable agreement terms that lenders legitimately
 * need to evaluate and fulfill a loan request, plus the public underwriting threshold.
 *
 * SENSITIVE PRIVATE DATA:
 * The borrower's actual private financial value (e.g. salary, account balance) is queried
 * via client-side private witness `getPrivateFinancialValue()` and NEVER stored on-chain or returned.
 *
 * PUBLIC RESULT:
 * Only the public threshold (`eligibilityThreshold`) and the zero-knowledge verification
 * result flag (`isEligibilityVerified`) are exposed on the ledger.
 */
export struct LoanDetails {
  borrower: Bytes<32>,
  lender: Maybe<Bytes<32>>,
  amount: Uint<64>,
  interestRateBasisPoints: Uint<16>,
  durationBlocks: Uint<32>,
  status: LoanStatus,
  eligibilityThreshold: Uint<64>,
  isEligibilityVerified: Boolean,
}

// -----------------------------------------------------------------------------
// On-chain Public Ledger State
// -----------------------------------------------------------------------------

// Discoverable loan participants
export ledger borrower: Bytes<32>;
export ledger lender: Maybe<Bytes<32>>;

// Public loan terms required for marketplace discovery
export ledger amount: Uint<64>;
export ledger interestRateBasisPoints: Uint<16>;
export ledger durationBlocks: Uint<32>;

// Public loan lifecycle status
export ledger status: LoanStatus;

// Public eligibility threshold required to qualify for this loan request
export ledger eligibilityThreshold: Uint<64>;

// Public verification flag: confirms ZK eligibility proof verification
// without revealing the underlying private financial witnesses on-chain.
export ledger isEligibilityVerified: Boolean;

// -----------------------------------------------------------------------------
// Private Witness Declaration
// -----------------------------------------------------------------------------

/**
 * Witness interface for querying private borrower financial metrics locally.
 * Executed off-chain inside the prover; values are never disclosed directly.
 */
witness getPrivateFinancialValue(): Uint<64>;

// -----------------------------------------------------------------------------
// Contract Initialization
// -----------------------------------------------------------------------------

/**
 * Initializes the loan desk contract instance with the requested terms and eligibility threshold.
 * All public parameters are explicitly disclosed to the ledger state.
 * Eligibility starts unverified (false) and will be updated by future ZK proof circuits.
 */
constructor(
  borrowerPk: Bytes<32>,
  principalAmount: Uint<64>,
  interestRate: Uint<16>,
  termBlocks: Uint<32>,
  minThreshold: Uint<64>
) {
  assert(principalAmount > 0, "Loan amount must be greater than zero");
  assert(termBlocks > 0, "Loan duration must be greater than zero");
  assert(interestRate > 0 && interestRate <= 10000, "Interest rate must be between 1 and 10000 basis points");
  assert(minThreshold > 0, "Eligibility threshold must be greater than zero");

  borrower = disclose(borrowerPk);
  lender = none<Bytes<32>>();
  amount = disclose(principalAmount);
  interestRateBasisPoints = disclose(interestRate);
  durationBlocks = disclose(termBlocks);
  eligibilityThreshold = disclose(minThreshold);
  status = LoanStatus.requested;
  isEligibilityVerified = false;
}

// -----------------------------------------------------------------------------
// Verification Circuit
// -----------------------------------------------------------------------------

/**
 * Verifies that the borrower's confidential financial value satisfies
 * the public eligibility threshold without disclosing the private value.
 *
 * Security & Lifecycle Rules:
 * 1. Loan must be in `requested` state.
 * 2. Eligibility must not already be verified.
 * 3. Caller must be the borrower (`ownPublicKey().bytes == borrower`).
 * 4. Private value from witness must meet or exceed `eligibilityThreshold`.
 *
 * Privacy Guarantees:
 * - `privateValue` is fetched off-chain and NEVER written to ledger or returned.
 * - Only the boolean state transition `isEligibilityVerified = true` is committed.
 */
export circuit verifyEligibility(): [] {
  assert(status == LoanStatus.requested, "Loan is not in requested state");
  assert(!isEligibilityVerified, "Eligibility is already verified");
  assert(ownPublicKey().bytes == borrower, "Caller is not the borrower");

  const privateValue = getPrivateFinancialValue();
  const isEligible = privateValue >= eligibilityThreshold;
  assert(isEligible, "Borrower does not meet the required eligibility threshold");

  isEligibilityVerified = true;
}

// -----------------------------------------------------------------------------
// Funding Circuit
// -----------------------------------------------------------------------------

/**
 * Funds an eligible loan request.
 *
 * Security & Lifecycle Rules:
 * 1. Loan must be in `requested` state.
 * 2. Loan eligibility must be verified (`isEligibilityVerified == true`).
 * 3. Caller must be the designated lender (`ownPublicKey().bytes == lenderPk`).
 * 4. Lender must not be the borrower (`lenderPk != borrower`).
 *
 * On success:
 * - `lender` is assigned to `some<Bytes<32>>(disclose(lenderPk))`.
 * - `status` transitions to `LoanStatus.funded`.
 *
 * Privacy Guarantees:
 * - Borrower confidential financial data is never exposed or referenced.
 * - Funding evaluates strictly public terms and the public verification flag.
 */
export circuit fundLoan(lenderPk: Bytes<32>): [] {
  assert(status == LoanStatus.requested, "Loan is not in requested state");
  assert(isEligibilityVerified, "Loan eligibility has not been verified");
  assert(ownPublicKey().bytes == lenderPk, "Caller is not the designated lender");
  assert(lenderPk != borrower, "Borrower cannot fund their own loan");
  assert(lenderPk != pad(32, ""), "Lender public key cannot be empty");

  lender = some<Bytes<32>>(disclose(lenderPk));
  status = LoanStatus.funded;
}

// -----------------------------------------------------------------------------
// Inspection Circuits
// -----------------------------------------------------------------------------

// Circuit to inspect current loan status
export circuit getLoanStatus(): LoanStatus {
  return status;
}

// Circuit to inspect full public loan details
export circuit getLoanDetails(): LoanDetails {
  return LoanDetails {
    borrower: borrower,
    lender: lender,
    amount: amount,
    interestRateBasisPoints: interestRateBasisPoints,
    durationBlocks: durationBlocks,
    status: status,
    eligibilityThreshold: eligibilityThreshold,
    isEligibilityVerified: isEligibilityVerified,
  };
}
