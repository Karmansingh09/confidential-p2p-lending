{
  "name": "confidential-p2p-lending",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "contracts",
    "frontend"
  ],
  "scripts": {
    "compile:contracts": "npm run compile --workspace=contracts",
    "build:contracts": "npm run build --workspace=contracts",
    "typecheck:contracts": "npm run typecheck --workspace=contracts",
    "deploy:preprod": "node --experimental-strip-types scripts/deploy-preprod.ts",
    "diagnose:dust": "node --experimental-strip-types scripts/diagnose-dust-api.ts",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:frontend": "tsc --project contracts/tsconfig.json && npm run build --workspace=frontend",
    "typecheck:frontend": "npm run typecheck --workspace=frontend",
    "test": "node --experimental-strip-types --test tests/*.test.js"
  }
}
